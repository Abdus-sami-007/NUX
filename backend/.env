APP_NAME=TRAFFIC-X
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/traffic_x

# ============================================
# DATASET
# ============================================

DATA_DIR=D:/P/Traffic X/Training set
PROCESSED_DATA_DIR=D:/P/Traffic X/data/processed

TRAFFIC_TRAIN_FILE=traffic_train.csv
TRAFFIC_VALIDATION_FILE=traffic_validation.csv

FORECAST_TARGET_TRAIN_FILE=forecast_targets_train.csv
FORECAST_TARGET_VALIDATION_FILE=forecast_targets_validation.csv

NETWORK_FILE=network.csv
NODES_FILE=nodes.csv

INCIDENTS_TRAIN_FILE=incidents_train.csv
INCIDENTS_VALIDATION_FILE=incidents_validation.csv

CONTEXT_TRAIN_FILE=context_train.csv
CONTEXT_VALIDATION_FILE=context_validation.csv

ROADWORKS_TRAIN_FILE=roadworks_train.csv
ROADWORKS_VALIDATION_FILE=roadworks_validation.csv

SIGNAL_PLANS_FILE=signal_plans.csv
TURN_RESTRICTIONS_FILE=turn_restrictions.csv
PLANNING_CANDIDATES_FILE=planning_candidates.csv
OD_DEMAND_FILE=od_demand_profiles.csv
SCENARIO_EXAMPLES_FILE=scenario_examples.csv

# ============================================
# MACHINE LEARNING
# ============================================

MODEL_DIR=D:/P/Traffic X/models
FORECAST_MODEL_DIR=D:/P/Traffic X/models/forecasting

FORECAST_HORIZONS=15,30,45,60
RANDOM_SEED=42
N_JOBS=-1

# ============================================
# NETWORK DIGITAL TWIN
# ============================================

GRAPH_CACHE_FILE=D:/P/Traffic X/cache/network_graph.pkl

# ============================================
# COUNTERFACTUAL SIMULATION
# ============================================

SIMULATION_MAX_ITERATIONS=100
SIMULATION_CONVERGENCE_THRESHOLD=0.001
DEFAULT_DIVERSION_PERCENT=20

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=INFO

# ============================================
# SECURITY
# ============================================

SECRET_KEY=change-this-in-production